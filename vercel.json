
{
  "version": 2,
  "builds": [
    {
      "src": "server/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "client/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server/index.ts"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/client/public/$1"
    },
    {
      "src": "/manifest.json",
      "dest": "/client/public/manifest.json"
    },
    {
      "src": "/sw.js",
      "dest": "/client/public/sw.js"
    },
    {
      "src": "/tessdata/(.*)",
      "dest": "/client/public/tessdata/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/client/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
